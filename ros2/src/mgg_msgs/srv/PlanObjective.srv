# An explicit objective routed over the global graph: the route to a goal
# pose (NAVIGATE), or home (RETURN_HOME). RETURN_HOME routes to `goal`, the
# caller's home in the planning frame, and ends exactly there; only when
# `goal` is not finite does it route to the initial anchor. The response
# carries the whole route, shortcut where the map already vouches for the
# straight line, or a reason it could not be produced. The identity fields
# echo the map the route was planned on so the caller can tell a route from
# a superseded map apart from one it can execute.
uint8 NAVIGATE=1
uint8 RETURN_HOME=2
string mission_id
uint8 objective
geometry_msgs/Pose goal
string component_id
uint64 map_epoch
uint64 mapping_graph_revision
string geometry_revision
builtin_interfaces/Time map_source_stamp
---
uint8 SUCCEEDED=0
uint8 UNREACHABLE=1
uint8 STALE_REVISION=2
uint8 UNSUPPORTED_OBJECTIVE=3
uint8 BLOCKED=4
uint8 status
string component_id
uint64 map_epoch
uint64 mapping_graph_revision
string geometry_revision
builtin_interfaces/Time map_source_stamp
geometry_msgs/Pose[] path
string reason
