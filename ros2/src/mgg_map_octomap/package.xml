<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mgg_map_octomap</name>
  <version>1.0.0</version>
  <description>
    MOLA persistent products and a rolling local voxel implementation of
    mgg_core's MapInterface, both independent of ROS.
  </description>

  <maintainer email="giovanni.beltrame@polymtl.ca">Giovanni Beltrame</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>mgg_core</depend>
  <depend>eigen</depend>
  <depend>nlohmann_json</depend>
  <depend>openssl</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
